PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RETENTION_HOURS=1
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# REQUIRED for production — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Bootstrap the first admin account (required in production)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Administrator

# Local demos only — NEVER enable in production
# ALLOW_DEMO_USERS=true

# Frontend (Vite) — use /api for same-origin single-service deploys
VITE_API_URL=/api

# Optional override for static frontend path inside the container
# FRONTEND_DIST=/app/frontend/dist
